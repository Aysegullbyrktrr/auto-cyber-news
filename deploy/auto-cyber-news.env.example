# auto-cyber-news — systemd EnvironmentFile (secrets) — TEMPLATE
#
# Holds the SECRET and deployment-specific values for the systemd service.
# Non-secret runtime knobs (APP_ENV, LOG_FORMAT, SCHEDULER_INTERVAL_MINUTES,
# ALERTS_DRY_RUN, RETENTION_DAYS) are set as Environment= lines in
# deploy/auto-cyber-news.service and do NOT belong here.
#
# INSTALL (run as root on the production host):
#   sudo install -d -m 0750 /etc/auto-cyber-news
#   sudo cp deploy/auto-cyber-news.env.example /etc/auto-cyber-news/auto-cyber-news.env
#   sudo chown root:root /etc/auto-cyber-news/auto-cyber-news.env
#   sudo chmod 600       /etc/auto-cyber-news/auto-cyber-news.env
#   sudoedit /etc/auto-cyber-news/auto-cyber-news.env   # fill in the values below
#   sudo systemctl restart auto-cyber-news
#
# The unit loads it via: EnvironmentFile=-/etc/auto-cyber-news/auto-cyber-news.env
#
# Format rules (systemd EnvironmentFile):
#   - KEY=VALUE, one per line. No `export`. No inline `#` comments after a value.
#   - Do not wrap values in quotes unless the value itself needs them.
#   - Never commit the filled-in file to version control.

# --- Telegram (critical alerts) ---
# Get/rotate the token from @BotFather: /mybots -> select bot -> API Token -> Revoke.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- SMTP / email (daily digest) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# --- AI summaries (optional; rule-based summaries are used when unset) ---
# Provider chosen by key presence: Gemini first, then Claude.
GEMINI_API_KEY=
# GEMINI_SUMMARY_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
# ANTHROPIC_SUMMARY_MODEL=claude-haiku-4-5

# --- Optional per-host overrides (uncomment to override service/app defaults) ---
# SQLITE_PATH=/opt/auto-cyber-news/data/auto-cyber-news.db
# DIGEST_TIMEZONE=Europe/Istanbul
# ALERTS_DRY_RUN=false
