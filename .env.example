APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=console
CONFIG_DIR=config
SQLITE_PATH=data/auto-cyber-news.db
DIGEST_TIMEZONE=UTC

# Scheduler / autonomous runtime
SCHEDULER_INTERVAL_MINUTES=60
RETENTION_DAYS=30
ALERTS_DRY_RUN=false
ALERT_COOLDOWN_HOURS=6

TELEGRAM_BOT_TOKEN=
# One or more recipients (comma-separated): a personal chat, several users,
# and/or a group/channel ID. Example: TELEGRAM_CHAT_ID=123456789,-1009876543210
TELEGRAM_CHAT_ID=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Optional AI summaries (rule-based fallback is used when none is set).
# Provider is chosen by which key is present: Gemini first, then Claude.
# Google Gemini (free tier friendly):
GEMINI_API_KEY=
# GEMINI_SUMMARY_MODEL=gemini-2.5-flash
# Anthropic Claude (paid):
ANTHROPIC_API_KEY=
# ANTHROPIC_SUMMARY_MODEL=claude-haiku-4-5
# SUMMARY_TIMEOUT_SECONDS=12
# AI summary output language (e.g. Turkish, English). Default: English.
# SUMMARY_LANGUAGE=English

